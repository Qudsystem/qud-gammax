{
    "name": "gammax",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:all": "concurrently -k -n WEB,API -c blue,magenta \"npm run dev\" \"npm --prefix backend start\"",
        "build": "tsc && vite build",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "test": "vitest",
        "dev:debug": "DEBUG=* vite --debug",
        "audit:events": "node scripts/audit-events.cjs",
        "test:interactions": "npm run test -- --testPathPattern=interactions",
        "fix:icons": "node scripts/fix-icons.cjs",
        "validate:all": "npm run audit:events && npm run test:interactions"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@phosphor-icons/react": "2.1.10",
        "@radix-ui/react-dialog": "1.1.15",
        "@radix-ui/react-label": "2.1.8",
        "@radix-ui/react-popover": "1.1.15",
        "@radix-ui/react-scroll-area": "1.2.10",
        "@radix-ui/react-select": "2.2.6",
        "@radix-ui/react-separator": "1.1.8",
        "@radix-ui/react-slot": "1.2.4",
        "@radix-ui/react-tabs": "1.1.13",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "cmdk": "0.2.1",
        "date-fns": "3.6.0",
        "framer-motion": "11.18.2",
        "lucide-react": "0.344.0",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "recharts": "2.15.4",
        "sonner": "1.7.4",
        "tailwind-merge": "2.6.1"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "6.4.3",
        "@testing-library/react": "16.3.1",
        "@testing-library/user-event": "14.5.2",
        "@types/node": "20.19.27",
        "@types/react": "18.3.27",
        "@types/react-dom": "18.3.7",
        "@types/testing-library__jest-dom": "6.0.0",
        "@vitejs/plugin-react": "4.7.0",
        "autoprefixer": "10.4.23",
        "concurrently": "8.2.2",
        "jsdom": "24.0.0",
        "postcss": "8.5.6",
        "tailwindcss": "3.4.19",
        "typescript": "5.9.3",
        "vite": "7.3.0",
        "vitest": "4.0.16"
    }
}
