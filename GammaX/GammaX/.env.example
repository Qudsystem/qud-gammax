# Use one of the following options:

# Option 1: Ollama Local (FREE - no API key needed)
# Just install Ollama on your computer and run it
# https://ollama.ai
# No environment variables needed!

# Option 2: Ollama Cloud with Custom Endpoint (if you have API key)
# VITE_OLLAMA_ENDPOINT=https://your-ollama-cloud-endpoint
# VITE_OLLAMA_API_KEY=your-ollama-cloud-api-key

# Option 3: OpenAI API (as fallback)
VITE_API_KEY=your-openai-api-key-here
